{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZX Sidekick game definition, format 1",
  "description": "A game definition.",
  "type": "object",
  "properties": {
    "actions": {
      "description": "Things a button or key can do.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "cheats": {
      "description": "Training switches.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cheat"
      }
    },
    "game": {
      "description": "Which game this is.",
      "$ref": "#/$defs/Game"
    },
    "guidance": {
      "description": "The guidance levels.",
      "anyOf": [
        {
          "$ref": "#/$defs/Guidance"
        },
        {
          "type": "null"
        }
      ]
    },
    "high_scores": {
      "description": "The game's high-score table.",
      "anyOf": [
        {
          "$ref": "#/$defs/HighScores"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "description": "The dumps supported.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Media"
      }
    },
    "pad": {
      "description": "What a pad does, by state (`default` for every state).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Pad"
      }
    },
    "panel": {
      "description": "The panel's widgets, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Widget"
      }
    },
    "persist": {
      "description": "Lists kept between games.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Persist"
      }
    },
    "run": {
      "description": "How the game is run.",
      "anyOf": [
        {
          "$ref": "#/$defs/Run"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "description": "The format, 1.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "script": {
      "description": "The definition's script.",
      "anyOf": [
        {
          "$ref": "#/$defs/Script"
        },
        {
          "type": "null"
        }
      ]
    },
    "situations": {
      "description": "How a crafted situation enters play.",
      "anyOf": [
        {
          "$ref": "#/$defs/Situations"
        },
        {
          "type": "null"
        }
      ]
    },
    "states": {
      "description": "Moments of the game, checked in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/State"
      }
    },
    "text_entry": {
      "description": "Typing a word the game asks for, with a pad.",
      "anyOf": [
        {
          "$ref": "#/$defs/TextEntry"
        },
        {
          "type": "null"
        }
      ]
    },
    "values": {
      "description": "Named facts about the game's memory.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Value"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "game",
    "media"
  ],
  "$defs": {
    "Action": {
      "description": "`[[actions]]`: something a button or key does beyond a key or a direction.",
      "type": "object",
      "properties": {
        "frames": {
          "description": "How many frames it lasts.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "host_key": {
          "description": "A key the Spectrum doesn't have that also does it.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Its name. `end-game` is the menu's \"End this game\".",
          "type": "string"
        },
        "joystick": {
          "description": "Joystick directions or fire held while it lasts.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keys": {
          "description": "Keys held while it lasts.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "description": "Its text where shown.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "Why and how it works.",
          "type": [
            "string",
            "null"
          ]
        },
        "patch_for_frame": {
          "description": "Patches applied while it lasts, then undone.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Patch"
          }
        },
        "script": {
          "description": "A function of the script to call.",
          "type": [
            "string",
            "null"
          ]
        },
        "tap": {
          "description": "Keys pressed for `frames` frames.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Add": {
      "description": "Where a kept list's entries come from.",
      "anyOf": [
        {
          "description": "`\"script\"`: the script returns them.",
          "$ref": "#/$defs/ScriptWord"
        },
        {
          "description": "A value read while the game is in a state.",
          "type": "object",
          "properties": {
            "in_state": {
              "description": "The state.",
              "type": "string"
            },
            "value": {
              "description": "The value.",
              "type": "string"
            }
          },
          "required": [
            "value",
            "in_state"
          ]
        }
      ]
    },
    "Address": {
      "description": "A 16-bit address: a number from 0 to 65535, or a \"0x\" hex string.",
      "oneOf": [
        {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(0[xX][0-9A-Fa-f]{1,4}|[0-9]{1,5})$"
        }
      ]
    },
    "Amount": {
      "description": "A number, or a value's full amount.",
      "anyOf": [
        {
          "description": "This number.",
          "type": "integer",
          "format": "int64"
        },
        {
          "description": "`\"max\"`: the value's `max`.",
          "$ref": "#/$defs/Max"
        }
      ]
    },
    "Bytes": {
      "description": "Bytes in hex, separated by spaces: \"CD 40 75\".",
      "type": "string",
      "pattern": "^\\s*([0-9A-Fa-f]{2}(\\s+[0-9A-Fa-f]{2})*)?\\s*$"
    },
    "Charset": {
      "description": "How a `text` value's codes map to letters.",
      "anyOf": [
        {
          "description": "`\"ascii\"`.",
          "$ref": "#/$defs/NamedCharset"
        },
        {
          "description": "A table of the game's own.",
          "type": "object",
          "properties": {
            "chars": {
              "description": "The letters, in code order.",
              "type": "string"
            },
            "first": {
              "description": "The code of the first letter in `chars`.",
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "first",
            "chars"
          ]
        }
      ]
    },
    "Cheat": {
      "description": "`[[cheats]]`: a training switch.",
      "type": "object",
      "properties": {
        "hold": {
          "description": "Values that may not go down while it's on.",
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany3"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Its name.",
          "type": "string"
        },
        "label": {
          "description": "Its text in the menu.",
          "type": "string"
        },
        "marks_score": {
          "description": "Whether a game played with it on is a training game.",
          "type": "boolean"
        },
        "note": {
          "description": "Why and how it works.",
          "type": [
            "string",
            "null"
          ]
        },
        "patch": {
          "description": "Patches applied while it's on.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Patch"
          }
        },
        "set": {
          "description": "Values written at each sync point while it's on.",
          "anyOf": [
            {
              "$ref": "#/$defs/OneOrMany2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "Column": {
      "description": "Where a widget goes in the panel.",
      "oneOf": [
        {
          "description": "The panel's whole width, below everything in the columns above it.",
          "type": "string",
          "const": "full"
        },
        {
          "description": "The left column.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "The right column, right-aligned.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "Count": {
      "description": "How many: a number, or the value that holds it.",
      "anyOf": [
        {
          "description": "A fixed number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "description": "The value that holds it.",
          "type": "string"
        }
      ]
    },
    "DirectionKeys": {
      "description": "A game's own keys for the joystick's directions and fire.",
      "type": "object",
      "properties": {
        "down": {
          "description": "Down.",
          "type": "string"
        },
        "fire": {
          "description": "Fire.",
          "type": "string"
        },
        "left": {
          "description": "Left.",
          "type": "string"
        },
        "right": {
          "description": "Right.",
          "type": "string"
        },
        "up": {
          "description": "Up.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "up",
        "down",
        "left",
        "right",
        "fire"
      ]
    },
    "Field": {
      "description": "A field of a table's records, or of a high-score entry.",
      "type": "object",
      "properties": {
        "bits": {
          "description": "Only these bits: true when they're set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "charset": {
          "description": "For `text`: how codes map to letters.",
          "anyOf": [
            {
              "$ref": "#/$defs/Charset"
            },
            {
              "type": "null"
            }
          ]
        },
        "len": {
          "description": "Its length, for the multi-byte types.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "description": "Its offset within the record.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "description": "What kind of value it is.",
          "$ref": "#/$defs/ValueType"
        }
      },
      "additionalProperties": false,
      "required": [
        "offset",
        "type"
      ]
    },
    "Game": {
      "description": "`[game]`: which game this is.",
      "type": "object",
      "properties": {
        "authors": {
          "description": "Who wrote it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "description": "Unique, lowercase letters, digits, `-` and `_`: names the data folder and the file.",
          "type": "string"
        },
        "machine": {
          "description": "The Spectrum it runs on.",
          "$ref": "#/$defs/Machine"
        },
        "notice": {
          "description": "Replaces the standard \"not affiliated\" notice; keep its meaning.",
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "description": "Who published it.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "In plain text, as the game is known.",
          "type": "string"
        },
        "year": {
          "description": "The year it was published.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "machine"
      ]
    },
    "Guidance": {
      "description": "`[guidance]`: the guidance levels.",
      "type": "object",
      "properties": {
        "levels": {
          "description": "From 0 (no help) up.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Level"
          }
        }
      },
      "additionalProperties": false
    },
    "HighScores": {
      "description": "`[high_scores]`: the game's table.",
      "type": "object",
      "properties": {
        "addr": {
          "description": "Where the table starts.",
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "description": "How many entries.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "The entry's name.",
          "anyOf": [
            {
              "$ref": "#/$defs/Field"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "description": "The entry's score.",
          "anyOf": [
            {
              "$ref": "#/$defs/Field"
            },
            {
              "type": "null"
            }
          ]
        },
        "stride": {
          "description": "Bytes from one entry to the next.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "description": "The table's heading in the panel after a game: the game's own name for it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Hint": {
      "description": "One thing to press, and what it does.",
      "type": "object",
      "properties": {
        "does": {
          "description": "What it does: \"fire\".",
          "type": "string"
        },
        "keys": {
          "description": "The keyboard's key as shown (`\"Alt\"`), or arrows (`\"← ↑ → ↓\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "pad": {
          "description": "The pad part that does it, by position: `west`, `dpad`…",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "does"
      ]
    },
    "Joystick": {
      "description": "What a pad's directions drive.",
      "oneOf": [
        {
          "description": "The Kempston joystick.",
          "type": "string",
          "const": "kempston"
        },
        {
          "description": "Sinclair joystick 1 (keys 6–0).",
          "type": "string",
          "const": "sinclair1"
        },
        {
          "description": "Sinclair joystick 2 (keys 1–5).",
          "type": "string",
          "const": "sinclair2"
        },
        {
          "description": "The cursor keys (5–8, 0 to fire).",
          "type": "string",
          "const": "cursor"
        },
        {
          "description": "The game's own keys, named in `[run] keys`.",
          "type": "string",
          "const": "keys"
        }
      ]
    },
    "Layout": {
      "description": "The order of a picture's bytes.",
      "oneOf": [
        {
          "description": "Row by row, top to bottom, each row left to right.",
          "type": "string",
          "const": "rows"
        },
        {
          "description": "In 8 × 8 character cells, left to right then top to bottom, each cell's eight rows in\nturn, as the screen's characters are drawn.",
          "type": "string",
          "const": "cells"
        }
      ]
    },
    "Level": {
      "description": "A guidance level.",
      "type": "object",
      "properties": {
        "description": {
          "description": "What it adds, in a line.",
          "type": "string"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ]
    },
    "Machine": {
      "description": "The Spectrum a game runs on.",
      "oneOf": [
        {
          "description": "The 48K.",
          "type": "string",
          "const": "48k"
        },
        {
          "description": "The 128K.",
          "type": "string",
          "const": "128k"
        }
      ]
    },
    "Mask": {
      "description": "Where sprites keep their masks.",
      "oneOf": [
        {
          "description": "No mask.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "A mask byte before each byte.",
          "type": "string",
          "const": "interleaved"
        },
        {
          "description": "The mask after the picture.",
          "type": "string",
          "const": "after"
        }
      ]
    },
    "Max": {
      "description": "The word `max`.",
      "oneOf": [
        {
          "description": "The value's `max`.",
          "type": "string",
          "const": "max"
        }
      ]
    },
    "Media": {
      "description": "`[[media]]`: a dump the definition supports.",
      "type": "object",
      "properties": {
        "download": {
          "description": "Where the player can get it legally.",
          "type": [
            "string",
            "null"
          ]
        },
        "download_label": {
          "description": "The download link's text.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "File names it's distributed under, matched in any case.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "description": "The tape's format.",
          "$ref": "#/$defs/TapeFormat"
        },
        "name": {
          "description": "How the tape prompt names the dump.",
          "type": "string"
        },
        "sha1": {
          "description": "The SHA-1 of the tape file itself (not a zip around it), 40 hex digits.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "NamedCharset": {
      "description": "A charset with a name.",
      "oneOf": [
        {
          "description": "ASCII.",
          "type": "string",
          "const": "ascii"
        }
      ]
    },
    "Notice": {
      "description": "What a card over the picture says: a line, and hints along its bottom.",
      "type": "object",
      "properties": {
        "hints": {
          "description": "What to press, along the bottom.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hint"
          }
        },
        "text": {
          "description": "The line: \"Move or fire to go on.\"",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "OneOrMany": {
      "description": "One of something, or a list of them.",
      "anyOf": [
        {
          "description": "Just one.",
          "$ref": "#/$defs/Address"
        },
        {
          "description": "A list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          }
        }
      ]
    },
    "OneOrMany2": {
      "description": "One of something, or a list of them.",
      "anyOf": [
        {
          "description": "Just one.",
          "$ref": "#/$defs/Set"
        },
        {
          "description": "A list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Set"
          }
        }
      ]
    },
    "OneOrMany3": {
      "description": "One of something, or a list of them.",
      "anyOf": [
        {
          "description": "Just one.",
          "type": "string"
        },
        {
          "description": "A list.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "Pad": {
      "description": "`[pad.*]`: what each part of a pad does in a state (`default` for all states).",
      "type": "object",
      "properties": {
        "dpad": {
          "description": "The D-pad.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "east": {
          "description": "The right face button.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "l1": {
          "description": "The left shoulder.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "l2": {
          "description": "The left trigger.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "north": {
          "description": "The top face button.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "r1": {
          "description": "The right shoulder.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "r2": {
          "description": "The right trigger.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "select": {
          "description": "Select (always the guidance menu).",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "south": {
          "description": "The bottom face button.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "description": "Start.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "stick": {
          "description": "The left stick.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "west": {
          "description": "The left face button.",
          "anyOf": [
            {
              "$ref": "#/$defs/PadTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "PadTable": {
      "description": "Keys, a tap, or an action.",
      "type": "object",
      "properties": {
        "action": {
          "description": "An action's id.",
          "type": [
            "string",
            "null"
          ]
        },
        "frames": {
