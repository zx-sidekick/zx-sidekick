{
  "name": "main: require CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "no game or ROM data committed"
          },
          {
            "context": "build, test and lint (ubuntu-latest)"
          },
          {
            "context": "build, test and lint (macos-latest)"
          },
          {
            "context": "build, test and lint (windows-latest)"
          },
          {
            "context": "dependency policy"
          },
          {
            "context": "build for Intel Mac"
          }
        ]
      }
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "required_linear_history"
    }
  ]
}
